{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "cache": {
      "enabled": false
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "chart.umd.js",
                "input": "node_modules/chart.js/dist",
                "output": "lib/chartjs/4"
              },
              {
                "glob": "echarts.min.js",
                "input": "node_modules/echarts/dist",
                "output": "lib/echarts/5"
              },
              {
                "glob": "d3.min.js",
                "input": "node_modules/d3/dist",
                "output": "lib/d3/7"
              },
              {
                "glob": "plotly.min.js",
                "input": "node_modules/plotly.js-dist-min",
                "output": "lib/plotly/2"
              },
              {
                "glob": "mermaid.min.js",
                "input": "node_modules/mermaid/dist",
                "output": "lib/mermaid/11"
              },
              {
                "glob": "three.module.min.js",
                "input": "node_modules/three/build",
                "output": "lib/three/0.169"
              },
              {
                "glob": "preact.module.js",
                "input": "node_modules/preact/dist",
                "output": "lib/preact/10"
              },
              {
                "glob": "hooks.module.js",
                "input": "node_modules/preact/hooks/dist",
                "output": "lib/preact/10"
              },
              {
                "glob": "htm.module.js",
                "input": "node_modules/htm/dist",
                "output": "lib/htm/3"
              },
              {
                "glob": "standalone.module.js",
                "input": "node_modules/htm/preact",
                "output": "lib/htm/3"
              },
              {
                "glob": "cdn.min.js",
                "input": "node_modules/alpinejs/dist",
                "output": "lib/alpine/3"
              },
              {
                "glob": "index.mjs",
                "input": "node_modules/@tailwindcss/browser/dist",
                "output": "lib/tailwind/4"
              },
              {
                "glob": "marked.min.js",
                "input": "node_modules/marked",
                "output": "lib/marked/14"
              },
              {
                "glob": "highlight.min.js",
                "input": "node_modules/@highlightjs/cdn-assets",
                "output": "lib/highlight/11"
              },
              {
                "glob": "github-dark.min.css",
                "input": "node_modules/@highlightjs/cdn-assets/styles",
                "output": "lib/highlight/11"
              },
              {
                "glob": "papaparse.min.js",
                "input": "node_modules/papaparse",
                "output": "lib/papaparse/5"
              },
              {
                "glob": "dayjs.min.js",
                "input": "node_modules/dayjs",
                "output": "lib/dayjs/1"
              },
              {
                "glob": "lodash.min.js",
                "input": "node_modules/lodash",
                "output": "lib/lodash/4"
              },
              {
                "glob": "plot.umd.min.js",
                "input": "node_modules/@observablehq/plot/dist",
                "output": "lib/plot/0.6"
              },
              {
                "glob": "apexcharts.min.js",
                "input": "node_modules/apexcharts/dist",
                "output": "lib/apexcharts/3"
              },
              {
                "glob": "lucide.min.js",
                "input": "node_modules/lucide/dist/umd",
                "output": "lib/lucide/0.460"
              },
              {
                "glob": "gridjs.umd.js",
                "input": "node_modules/gridjs/dist",
                "output": "lib/gridjs/6"
              },
              {
                "glob": "mermaid.min.css",
                "input": "node_modules/gridjs/dist/theme",
                "output": "lib/gridjs/6"
              },
              {
                "glob": "cytoscape.min.js",
                "input": "node_modules/cytoscape/dist",
                "output": "lib/cytoscape/3"
              },
              {
                "glob": "anime.min.js",
                "input": "node_modules/animejs/lib",
                "output": "lib/anime/3"
              }
            ],
            "styles": [
              "src/styles.scss",
              {
                "input": "src/styles-storage.scss",
                "bundleName": "storage-page",
                "inject": false
              }
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1.4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "chart.umd.js",
                "input": "node_modules/chart.js/dist",
                "output": "lib/chartjs/4"
              },
              {
                "glob": "echarts.min.js",
                "input": "node_modules/echarts/dist",
                "output": "lib/echarts/5"
              },
              {
                "glob": "d3.min.js",
                "input": "node_modules/d3/dist",
                "output": "lib/d3/7"
              },
              {
                "glob": "plotly.min.js",
                "input": "node_modules/plotly.js-dist-min",
                "output": "lib/plotly/2"
              },
              {
                "glob": "mermaid.min.js",
                "input": "node_modules/mermaid/dist",
                "output": "lib/mermaid/11"
              },
              {
                "glob": "three.module.min.js",
                "input": "node_modules/three/build",
                "output": "lib/three/0.169"
              },
              {
                "glob": "preact.module.js",
                "input": "node_modules/preact/dist",
                "output": "lib/preact/10"
              },
              {
                "glob": "hooks.module.js",
                "input": "node_modules/preact/hooks/dist",
                "output": "lib/preact/10"
              },
              {
                "glob": "htm.module.js",
                "input": "node_modules/htm/dist",
                "output": "lib/htm/3"
              },
              {
                "glob": "standalone.module.js",
                "input": "node_modules/htm/preact",
                "output": "lib/htm/3"
              },
              {
                "glob": "cdn.min.js",
                "input": "node_modules/alpinejs/dist",
                "output": "lib/alpine/3"
              },
              {
                "glob": "index.mjs",
                "input": "node_modules/@tailwindcss/browser/dist",
                "output": "lib/tailwind/4"
              },
              {
                "glob": "marked.min.js",
                "input": "node_modules/marked",
                "output": "lib/marked/14"
              },
              {
                "glob": "highlight.min.js",
                "input": "node_modules/@highlightjs/cdn-assets",
                "output": "lib/highlight/11"
              },
              {
                "glob": "github-dark.min.css",
                "input": "node_modules/@highlightjs/cdn-assets/styles",
                "output": "lib/highlight/11"
              },
              {
                "glob": "papaparse.min.js",
                "input": "node_modules/papaparse",
                "output": "lib/papaparse/5"
              },
              {
                "glob": "dayjs.min.js",
                "input": "node_modules/dayjs",
                "output": "lib/dayjs/1"
              },
              {
                "glob": "lodash.min.js",
                "input": "node_modules/lodash",
                "output": "lib/lodash/4"
              },
              {
                "glob": "plot.umd.min.js",
                "input": "node_modules/@observablehq/plot/dist",
                "output": "lib/plot/0.6"
              },
              {
                "glob": "apexcharts.min.js",
                "input": "node_modules/apexcharts/dist",
                "output": "lib/apexcharts/3"
              },
              {
                "glob": "lucide.min.js",
                "input": "node_modules/lucide/dist/umd",
                "output": "lib/lucide/0.460"
              },
              {
                "glob": "gridjs.umd.js",
                "input": "node_modules/gridjs/dist",
                "output": "lib/gridjs/6"
              },
              {
                "glob": "mermaid.min.css",
                "input": "node_modules/gridjs/dist/theme",
                "output": "lib/gridjs/6"
              },
              {
                "glob": "cytoscape.min.js",
                "input": "node_modules/cytoscape/dist",
                "output": "lib/cytoscape/3"
              },
              {
                "glob": "anime.min.js",
                "input": "node_modules/animejs/lib",
                "output": "lib/anime/3"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
