# Settings of the isolated inbound E2E stack (tests/e2e/compose.e2e.yml). Replaces the repo's .env for that stack only.
COMPOSE_PROFILES=inbound-logging
INTERNAL_CALL_SERVICES=e2e:18080:8000
INTERNAL_CALLS_RETENTION_ROWS=50
INTERNAL_CALLS_STORAGE=sqlite
ALFRED_LOGS_DIR=./tests/e2e/.work/logs
FORWARD_PROXY_PORT_MAP=
