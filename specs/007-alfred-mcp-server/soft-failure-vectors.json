{
  "about": "Shared vectors for the error-inside-a-2xx-body and empty-result rules. The frontend (shared/utils/soft-failure.ts) and the backend (backend-triage SoftFailures) both run every vector in their tests, so the two implementations cannot drift apart. Expectations were produced by the TypeScript; to add a case, add it here with the expectation the TypeScript gives.",
  "vectors": [
    {
      "name": "json ok, nothing wrong",
      "status": 200,
      "error": null,
      "body": "{\"data\":{\"id\":7},\"offers\":[{\"a\":1}]}",
      "softFailure": null,
      "emptyKeys": null
    },
    {
      "name": "json errors list with code",
      "status": 200,
      "error": null,
      "body": "{\"errors\":[{\"code\":\"322\",\"message\":\"No availability\"}]}",
      "softFailure": {
        "kind": "json-errors",
        "code": "322",
        "message": "No availability"
      },
      "emptyKeys": null
    },
    {
      "name": "json Errors object, first value",
      "status": 200,
      "error": null,
      "body": "{\"Errors\":{\"b\":{\"Code\":12,\"Message\":\"second\"},\"a\":\"first\"}}",
      "softFailure": {
        "kind": "json-errors",
        "code": "12",
        "message": "second"
      },
      "emptyKeys": null
    },
    {
      "name": "json errors object with integer-like keys comes first",
      "status": 200,
      "error": null,
      "body": "{\"errors\":{\"x\":\"later\",\"2\":\"two\",\"1\":\"one\"}}",
      "softFailure": {
        "kind": "json-errors",
        "code": null,
        "message": "one"
      },
      "emptyKeys": null
    },
    {
      "name": "json errors empty list falls through",
