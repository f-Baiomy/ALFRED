<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.alfred</groupId>
    <artifactId>pennyworth-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>pennyworth-app</artifactId>
  <name>pennyworth-app</name>
  <description>
    Composition root - the only module that depends on every slice, and the only one nothing
    else depends on. Owns the @SpringBootApplication main class, application.properties, and
    the spring-boot-maven-plugin repackage that produces the runnable jar Docker ships.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.alfred</groupId>
      <artifactId>pennyworth-platform</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alfred</groupId>
      <artifactId>pennyworth-calls</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alfred</groupId>
      <artifactId>pennyworth-comments</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alfred</groupId>
      <artifactId>pennyworth-export</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>pennyworth</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
