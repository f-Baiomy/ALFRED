<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.alfred</groupId>
    <artifactId>pennyworth-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>pennyworth-architecture-test</artifactId>
  <name>pennyworth-architecture-test</name>
  <description>
    Test-only module with no production code. Depends on every other module so its ArchUnit
    suite can inspect the fully assembled classpath and fail the build if the
    domain/application/adapter dependency direction, or the "controllers depend on ports, not
    services" rule, is ever violated within a slice.
  </description>
  <packaging>jar</packaging>

  <dependencies>
    <dependency>
      <groupId>com.alfred</groupId>
      <artifactId>pennyworth-platform</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alfred</groupId>
      <artifactId>pennyworth-calls</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alfred</groupId>
      <artifactId>pennyworth-comments</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alfred</groupId>
      <artifactId>pennyworth-export</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alfred</groupId>
      <artifactId>pennyworth-session-cycles</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alfred</groupId>
      <artifactId>pennyworth-profiles</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
