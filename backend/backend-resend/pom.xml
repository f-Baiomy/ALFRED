<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.fathy.alfred</groupId>
    <artifactId>backend-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>backend-resend</artifactId>
  <name>backend-resend</name>
  <description>Vertical slice: re-sends a logged call back through Alfred's own proxies, so interception rules apply and the new exchange is logged and linked to its original. Hexagonal internally (domain/application/adapter packages under com.fathy.alfred.backend.resend). A leaf slice - it reads calls only through out-ports that backend-app's resendbridge implements, so it depends on no other slice and none depends on it.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- JdkHttpCallSender's inbound send sets a Host header itself - the JDK's HttpClient
               refuses that by default (host.md is a restricted header); this flag is the same one
               docker-compose.yml sets via JAVA_TOOL_OPTIONS for the running backend. -->
          <argLine>-Djdk.httpclient.allowRestrictedHeaders=host</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
