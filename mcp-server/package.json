{
  "name": "alfred-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Local stdio MCP server that lets Claude Code read and annotate Alfred's recorded calls, session cycles and database capture through Alfred's existing HTTP API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "tsx --test --test-timeout=60000 test/*.test.ts",
    "test:http": "node scripts/test-http.mjs",
    "typecheck": "tsc --noEmit",
    "live-check": "tsx scripts/live-check.ts",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jsdom": "26.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.5",
    "esbuild": "0.25.10",
    "tsx": "4.23.15",
    "typescript": "5.5.4"
  }
}
