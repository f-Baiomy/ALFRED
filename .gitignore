# Generated at runtime - CA cert, keys, mitmproxy state
proxy/certs/

# Generated at runtime - captured request/response logs
proxy/logs/

# Generated at runtime - live on/off state for the inbound reverse-proxy toggle, shared via
# bind-mount between reverse-proxy and backend (see docker-compose.yml) - managed by
# toggle-wildfly-reverse-proxy.sh/.bat, not something to version
proxy/reverse-proxy-enabled.flag
# Same, for database capture's per-project switch (see docs/db-capture.md) - read by reverse-proxy,
# written by backend-db-capture.
proxy/db-capture-enabled.flag

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Java / Maven
backend/**/target/
db-agent/target/
*.class

# Node / Angular - already covered by frontend/.gitignore, repeated here as a
# safety net so `node_modules`/build output never gets committed even if that
# nested .gitignore is ever missing (e.g. a fresh clone before npm install)
frontend/node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*

# Generated at runtime - persisted call comments
backend/data/

# Docker / editor / OS noise
.env
# Generated by start.py/restart.py from settings.properties - see its own header
docker-compose.override.yml
.DS_Store
Thumbs.db
.vscode/
.idea/
/out/

# Generated by backend's FileRulesPublisherAdapter on every rule change and at startup - the
# directory is tracked (both proxies bind-mount it), the snapshot inside it is not. Same treatment
# as reverse-proxy-enabled.flag above.
proxy/interception/rules.json
proxy/interception/variables.json
# The stored answers published beside it (answers/<id>.meta.json and .body), generated the same way.
proxy/interception/answers/
# Relive run snapshots and in-flight calls, published by the backend at run time
proxy/interception/relive/

# CodeGraph code-intelligence index - local, machine-specific, rebuilt from the sources (see CLAUDE.md).
.codegraph/

# Logs Explorer server-file drop folder (mounted read-only at /logs)
logs-drop/

# Watched-folder log agent runtime files
log-agent/agent.pid
log-agent/agent.log
logs-watch-demo/
