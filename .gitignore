# Generated at runtime - CA cert, keys, mitmproxy state
proxy/certs/

# Generated at runtime - captured request/response logs
proxy/logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Java / Maven
backend/**/target/
*.class

# Node / Angular - already covered by frontend/.gitignore, repeated here as a
# safety net so `node_modules`/build output never gets committed even if that
# nested .gitignore is ever missing (e.g. a fresh clone before npm install)
frontend/node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*

# Generated at runtime - persisted call comments
backend/data/

# Docker / editor / OS noise
.env
.DS_Store
Thumbs.db
.vscode/
.idea/
/out/
