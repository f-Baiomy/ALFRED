# Example .env - documents every variable Alfred's docker-compose.yml and its host-side scripts
# read from .env. .env itself is gitignored and untouched by git (see .gitignore); this file is
# just its documentation, checked in so a fresh clone shows what's possible without reading
# start.py/restart.py/docker-compose.yml first.
#
# You normally do NOT hand-write .env. Run `python3 start.py` (or restart.py on an already-set-up
# checkout) - it generates .env for you, deriving every setting below from settings.properties
# the first time it sees each one. From then on, .env is what's actually running: re-running
# start.py/restart.py again will NOT overwrite a value already here, even if settings.properties
# changes (see settings.properties's own header for the full "fills a gap, never overwrites"
# rule, including its ${ENV_VAR:default} placeholder syntax).
#
# So there are only two reasons to ever edit this file directly:
#   1. Changing a setting that's already been adopted into .env once - editing settings.properties
#      alone no longer does it at that point.
#   2. A one-off override on this machine only, without touching the settings.properties everyone
#      else shares.
# Either way, re-run start.py/restart.py afterwards to re-sync docker-compose.override.yml and
# WildFly's port-offset from whatever you just changed.

# ---- Backend host ports ----
# Uncommented only when the default is already taken - start.py's ensure_backend_port() probes
# port 5000 and writes this itself the first time it finds a conflict. Rarely hand-set.
# BACKEND_PORT=5000

# Remote JDWP debug port for the backend container - attach IntelliJ's "Remote JVM Debug" run
# config to localhost:<this>. Override if 5006 collides with another project's own debug port.
# BACKEND_DEBUG_PORT=5006

# ---- Inbound logging (reverse-proxy) ----
# Whether reverse-proxy (the INBOUND frontend/other-client -> project logging service) starts at
# all. false: reverse-proxy never starts and Settings' "Inbound logging" panel is hidden - many
# deployments only need outbound logging, which runs unconditionally via "proxy" regardless of
# this flag. See settings.properties's reverse_proxy_enabled for the primary way to set this.
REVERSE_PROXY_ENABLED=false

# One entry per project reverse-proxy fronts for inbound logging and/or "proxy" fronts for
# outbound attribution: name:listenPort:upstreamPort[:outboundProxyHost[:outboundProxyPort]],
# comma-separated. See settings.properties's internal_call_services for the full field-by-field
# doc and examples - this is the exact same list, just already resolved into .env.
INTERNAL_CALL_SERVICES=

# Derived automatically from INTERNAL_CALL_SERVICES's optional 4th/5th fields by
# start.py/restart.py - not something you set directly. Left here, empty, so docker-compose.yml
# always has a value to substitute even before start.py has run once.
FORWARD_PROXY_PORT_MAP=

# How many INBOUND calls stay in the live list before the oldest is dropped (a row count, not a
# byte size - inbound calls are a flat ring-buffer file, not a database). See
# settings.properties's inbound_calls_retention_rows for the full doc on what raising this costs.
INTERNAL_CALLS_RETENTION_ROWS=1500

# Read by Docker Compose ITSELF (not this app) - activates the "inbound-logging" profile that
# gates the reverse-proxy service in docker-compose.yml, equivalent to always passing
# `--profile inbound-logging`. start.py/restart.py write this automatically whenever
# REVERSE_PROXY_ENABLED=true above, and remove the line entirely otherwise - leave it unset here.
# COMPOSE_PROFILES=inbound-logging
